# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://snguide:snguide@localhost:5432/snguide
# Used by pytest (tables are dropped and recreated on every run!)
TEST_DATABASE_URL=postgresql+psycopg://snguide:snguide@localhost:5432/snguide_test
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Google sign-in: comma-separated OAuth client IDs (web + android) from Google Cloud Console
GOOGLE_CLIENT_IDS=

# Browser origins allowed to call the API (admin panel dev server)
CORS_ORIGINS=http://localhost:5173
