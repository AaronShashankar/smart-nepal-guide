# Copy to .env (Expo loads it automatically). EXPO_PUBLIC_* values are bundled into the app,
# so never put secrets here.

# Backend URL as seen from the phone. Use your computer's LAN IP on a real device,
# e.g. http://192.168.1.10:8000 (start the API with --host 0.0.0.0).
# 10.0.2.2 is "the host computer" from inside the Android emulator.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# OAuth "Web application" client ID from Google Cloud Console (also listed in the
# backend's GOOGLE_CLIENT_IDS). Leave empty to hide Google sign-in errors behind a message.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
