# Copy to .env (Expo loads it automatically). EXPO_PUBLIC_* values are bundled into the app,
# so never put secrets here.

# Backend URL. Leave this commented out in development: the app uses the computer
# that serves Metro (same IP the phone already reaches) on port 8000.
# Start the API with --host 0.0.0.0 so the phone can reach it.
# Set it only to point at a different server, e.g. a deployed one:
# EXPO_PUBLIC_API_URL=https://api.example.com

# OAuth "Web application" client ID from Google Cloud Console (also listed in the
# backend's GOOGLE_CLIENT_IDS). Leave empty to hide Google sign-in errors behind a message.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Safety test mode (V2 Phase 3), optional: comma-separated phone numbers of your own (e.g. two
# friends' mobiles). While set, the app's emergency numbers (Police 100, Tourist Police 1144,
# Ambulance 102, Fire 101) and the SOS fallback call these instead, and every safety screen shows
# a "TEST MODE" banner. Leave it unset for a real release. Restart Metro after changing it.
# EXPO_PUBLIC_SAFETY_TEST_NUMBERS=98XXXXXXXX,98XXXXXXXX
